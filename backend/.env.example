# NestJS API
PORT=4000
# SQLite file (relative to backend/). DATABASE_URL=sqlite:../database/app.sqlite also works.
DATABASE_PATH=../database/app.sqlite
CORS_ORIGIN=http://localhost:3000

# Admin sessions (HttpOnly cookie + CSRF token). Change in production!
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
# Cookies are Secure automatically when NODE_ENV=production; force with COOKIE_SECURE=true/false
COOKIE_SECURE=

# Seeded on first boot only (when no admin exists)
ADMIN_EMAIL=admin@whitakerplumbing.local
ADMIN_PASSWORD=WhitakerAdmin#2026
ADMIN_NAME=Asher Whitaker

# Service-request rate limit per IP (default: 5 per 10 minutes)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# "Today" for preferred-date validation
BUSINESS_TZ=America/New_York

# Retention: delete completed, closed (and spam) leads after N months. 0 = keep (client to decide).
LEAD_RETENTION_MONTHS=0

# Optional: email the business for each new request (sent after the DB commit,
# retried up to 5 times by the outbox). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM="Whitaker Plumbing Website <no-reply@example.com>"
# Recipient; defaults to the business email in Admin → Settings when empty
NOTIFY_TO=
ADMIN_URL=http://localhost:3000/admin/leads
